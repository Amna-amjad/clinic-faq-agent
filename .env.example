# Copy this file to .env and fill in your TEST values only.
# NEVER commit .env, and NEVER paste a token into chat, code, or a screenshot.
# These are test values from Meta's WhatsApp API Setup page (see META_TEST_SETUP.md).

WHATSAPP_PHONE_NUMBER_ID=your-test-phone-number-id-here
WHATSAPP_ACCESS_TOKEN=your-temporary-test-token-here
META_VERIFY_TOKEN=choose-any-random-string-here
# Optional, only if you connect a second test number for routing:
# BRIGHT_SMILE_PHONE_NUMBER_ID=your-bright-smile-test-phone-number-id-here
# GREEN_VALLEY_PHONE_NUMBER_ID=your-green-valley-test-phone-number-id-here
PORT=8000
# WHATSAPP_DRY_RUN=1
